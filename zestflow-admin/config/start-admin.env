# ============================================================
# ZestFlow Admin 启动参数
# 路径：与 application.yml 同目录（config/start-admin.env）
# 修改后执行 ./start-admin.sh restart 生效
# ============================================================

# --- Java 运行时 ---
# Linux 非交互 shell 常无 java PATH，建议显式指定（二选一）：
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk
# JAVA_BIN=/usr/lib/jvm/java-17-openjdk/bin/java
# 查找：find /usr/lib/jvm -name java 2>/dev/null

# --- Spring Boot（留空则读 application.yml）---
# SPRING_PROFILE=prod
# SERVER_PORT=8080

# --- 堆内存 ---
# Admin 为管理端，推荐 Xms=Xmx 固定堆，避免运行时扩缩
# 4G 机器同机 MySQL：512m ~ 768m
# 8G 独占 Admin：1g
# 16G+：1g ~ 2g
JVM_XMS=512m
JVM_XMX=768m

# --- 垃圾回收：zgc | g1 ---
# JDK 17+ 默认 zgc；Oracle JDK 若 ZGC 报错可改为 g1
JVM_GC=g1
JVM_METASPACE=256m
JVM_DIRECT_MEMORY=256m
JVM_ZGC_CONC_THREADS=2
JVM_ZGC_INTERVAL=5
JVM_G1_MAX_PAUSE_MS=200

# --- 额外 JVM 参数（可选，空格分隔）---
# JVM_EXTRA_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005

# --- 进程控制 ---
STOP_TIMEOUT_SEC=15
HEALTH_CHECK_RETRIES=30
HEALTH_CHECK_INTERVAL_SEC=2

# --- 系统属性 ---
APP_TIMEZONE=Asia/Shanghai
