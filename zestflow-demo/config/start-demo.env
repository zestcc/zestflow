# ============================================================
# ZestFlow Demo 启动参数
# 路径：与 application.yml 同目录（config/start-demo.env）
# 修改后执行 ./start-demo.sh restart 生效
# ============================================================

# --- Java 运行时 ---
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# --- Spring Boot（留空则读 application.yml）---
# SPRING_PROFILE=prod
# SERVER_PORT=8081

# --- 堆内存 ---
# 4G 同机 MySQL + Admin + Demo：512m ~ 768m
# 8G+：1g
JVM_XMS=512m
JVM_XMX=768m

# --- 垃圾回收：zgc | g1 ---
# 小内存同机部署推荐 g1
JVM_GC=g1
JVM_METASPACE=256m
JVM_DIRECT_MEMORY=256m
JVM_ZGC_CONC_THREADS=2
JVM_ZGC_INTERVAL=5
JVM_G1_MAX_PAUSE_MS=200

# --- 进程控制 ---
STOP_TIMEOUT_SEC=15
HEALTH_CHECK_RETRIES=30
HEALTH_CHECK_INTERVAL_SEC=2

# --- 系统属性 ---
APP_TIMEZONE=Asia/Shanghai
