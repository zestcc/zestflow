# ZestFlow Admin 启动参数（生产包内置）
SPRING_PROFILE=prod

# 4G 同机 MySQL 推荐；8G 独占 Admin 可改为 1g
JVM_XMS=512m
JVM_XMX=768m
JVM_GC=g1
JVM_METASPACE=256m
JVM_DIRECT_MEMORY=256m
JVM_ZGC_CONC_THREADS=2
JVM_ZGC_INTERVAL=5
JVM_G1_MAX_PAUSE_MS=200

STOP_TIMEOUT_SEC=15
HEALTH_CHECK_RETRIES=30
HEALTH_CHECK_INTERVAL_SEC=2
APP_TIMEZONE=Asia/Shanghai
